<?xml version="1.0" encoding="utf-8"?>
<!-- Regras de extração de dados (Android 12+): o backup em nuvem e a
     transferência de dispositivo excluem a sessão do usuário. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="SyncMeetSession.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="SyncMeetSession.xml" />
    </device-transfer>
</data-extraction-rules>
